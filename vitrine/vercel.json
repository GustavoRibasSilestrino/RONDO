{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/corredor.webp", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ],
  "rewrites": [
    { "source": "/app", "destination": "https://rondo-app-eight.vercel.app/app" },
    { "source": "/app/", "destination": "https://rondo-app-eight.vercel.app/app" },
    { "source": "/app/:path+", "destination": "https://rondo-app-eight.vercel.app/app/:path+" },
    { "source": "/((?!assets/|app$|app/).*)", "destination": "/index.html" }
  ]
}
