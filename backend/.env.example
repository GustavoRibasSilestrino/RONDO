DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/postgres
JWT_SEGREDO=troque-por-um-segredo-longo
ORIGENS_PERMITIDAS=https://yesteryou.vercel.app

# fotos dos posts (Supabase Storage: crie um bucket publico chamado midia)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=chave-service_role
SUPABASE_BUCKET=midia

# voz do RONDIN para nomes e numeros (Azure Speech); so no servidor, nunca no app
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# recuperar a senha por e-mail (Brevo ou Resend, por API HTTP)
BREVO_API_KEY=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=RONDO
# so em desenvolvimento: escreve o e-mail no log em vez de enviar
EMAIL_MODO_TESTE=false

# entrar com Google e Apple (IDs de cliente, separados por virgula)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
